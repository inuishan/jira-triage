{
  "name": "jira-triage",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Card-based triage of Jira tickets from a JQL query, with persistent accept/reject tracking.",
  "scripts": {
    "dev": "node scripts/dev.js",
    "dev:mock": "JIRA_MOCK=1 npm run dev",
    "build": "vite build",
    "start": "npm run build && node server/index.js",
    "deploy": "bash scripts/deploy.sh",
    "test": "vitest run",
    "lint": "eslint ."
  },
  "engines": {
    "node": ">=22.13"
  },
  "dependencies": {
    "dotenv": "^18.0.6",
    "express": "^5.2.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "vite": "^8.3.3",
    "vitest": "^5.0.3"
  }
}
