# Copy to .env and fill in:  cp .env.example .env
# Never commit .env. Placeholder values only in this file.

# Jira Cloud site, e.g. https://your-site.atlassian.net
JIRA_BASE_URL=https://your-site.atlassian.net
# Atlassian account email used with the API token
JIRA_EMAIL=you@example.com
# Create at https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_API_TOKEN=

# HTTP port (server always binds 127.0.0.1). Default: 3001
PORT=3001

# Set to 1 to use test/fixtures/issues.json instead of real Jira
JIRA_MOCK=0

# SQLite path, relative to the project root. Default: data/triage.db
# DB_PATH=data/triage.db
